# Día de la votación (YYYY-MM-DD). Activa la veda de sondeos de los 5 días previos.
FECHA_ELECCION=2026-11-29
DOMINIO=example.org

# Cloudflare Turnstile (protección antibots del termómetro ciudadano)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sal fija (por ejemplo, openssl rand -hex 32) para el hash de 21 días del termómetro
TERMOMETRO_SALT=
TERMOMETRO_DB=/app/var/termometro.sqlite
